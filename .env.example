# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Settings → "Legacy JWT Secret". Used to mint short-lived
# Supabase-compatible access tokens for the browser client (see src/lib/supabase/authToken.ts)
# so RLS policies that check auth.uid() work even though sessions are NextAuth JWTs, not Supabase Auth.
SUPABASE_JWT_SECRET=

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cron auth — generate with: openssl rand -base64 32
# Vercel Cron sends this as a Bearer token to /api/cron/* routes automatically
# once set as an env var; not otherwise used outside of scheduled cron calls.
CRON_SECRET=

# Resend — get API key from resend.com dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TEST_EMAIL=

# Stripe — get keys from the Stripe dashboard (Developers → API keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → add endpoint (POST {APP_URL}/api/webhooks/stripe) → signing secret
STRIPE_WEBHOOK_SECRET=

# Admin alerts — refund failures, disputes, etc. are emailed here
ADMIN_EMAIL=

# Seed data — generate with: openssl rand -base64 32
# POST /api/seed re-runs src/scripts/seed-full.js against the three real
# controlled accounts (see that file). Set this ONLY in Vercel's Preview and
# Development environment scopes — never Production; the route itself also
# hard-blocks when VERCEL_ENV is 'production' regardless of this being set.
SEED_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cyprus Cleaners

# DeepL — get API key from deepl.com
DEEPL_API_KEY=
