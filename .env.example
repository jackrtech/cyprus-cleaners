# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Settings → "Legacy JWT Secret". Used to mint short-lived
# Supabase-compatible access tokens for the browser client (see src/lib/supabase/authToken.ts)
# so RLS policies that check auth.uid() work even though sessions are NextAuth JWTs, not Supabase Auth.
SUPABASE_JWT_SECRET=

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend — get API key from resend.com dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TEST_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cyprus Cleaners

# DeepL — get API key from deepl.com
DEEPL_API_KEY=
